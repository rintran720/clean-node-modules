{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clean Node Modules",
  "version": "0.1.0",
  "identifier": "dev.local.clean-node-modules",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Clean Node Modules", "width": 900, "height": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
